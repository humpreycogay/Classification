# Template for .env: copy it (cp .env.example .env) and fill in the secrets.
# .env is git-ignored; this file is not, so never put real keys here.

# Classifier configuration, one section per classifier (the runner registry name, Runner/apps.py).
# Read by every app (python-dotenv), the runner and the setup/serve scripts (shared/env.sh).
# A variable set in the shell wins over this file. Comments go on their own line (no trailing comments).
# Commented-out settings are optional; the app's own default applies (shown after the '#').

# ============================================================================
# Shared
# ============================================================================
# Ollama server used by embedsim, embedsup and the shortlist stage of every *_shortlist variant
# (llmqwen uses LLM_HOST below).
OLLAMA_HOST=http://127.0.0.1:11434
# Stage-1 embedding model of the *_shortlist variants (llmqwen, SemIf, verdict).
SHORTLIST_MODEL=bge-m3:567m
# Recorded in the run metadata only; set it to match your Ollama server's OLLAMA_NUM_PARALLEL.
# OLLAMA_NUM_PARALLEL=4

# ============================================================================
# jev: Jev (TypeSafe API), remote, paid
# ============================================================================
jev_api_name=
jev_api_key=
JEV_MODEL=jev-latest

# ============================================================================
# laya, laya_typed, laya_multilingual: Laya decision model (PyTorch)
# ============================================================================
# The three checkpoints are pinned in laya/classifier.py (convaiinnovations/laya@55cf4c4).
# english | multilingual | typed-decisions, for the laya entry run by hand. Default: route by the text's language.
# laya_typed and laya_multilingual pass --model, which wins over this.
# LAYA_MODEL=english
# Default: cuda, else mps, else cpu.
# LAYA_DEVICE=mps

# ============================================================================
# nli, nli_modernbert: NLI zero-shot (DeBERTa-v3-large / ModernBERT-large, PyTorch)
# ============================================================================
# The model of the nli entry. nli_modernbert passes --model MoritzLaurer/ModernBERT-large-zeroshot-v2.0,
# which wins over this. Known models are pinned (revision, dtype) in nli/classifier.py MODELS.
NLI_MODEL=MoritzLaurer/deberta-v3-large-zeroshot-v2.0
# Default: cuda, else mps, else cpu.
# NLI_DEVICE=mps

# ============================================================================
# gliclass: GLiClass base v3.0 (PyTorch)
# ============================================================================
GLICLASS_MODEL=knowledgator/gliclass-base-v3.0
# Default: cuda, else mps, else cpu.
# GLICLASS_DEVICE=mps

# ============================================================================
# verdict: Verdict, ModernBERT 151M (PyTorch)
# ============================================================================
VERDICT_MODEL=heman10x/rlcd-modernbert-151m
# Default: cuda, else mps, else cpu.
# VERDICT_DEVICE=mps
# Default: the temperature shipped with the checkpoint's calibrator (per label count).
# VERDICT_TEMPERATURE=1.0

# ============================================================================
# embedsim: embedding similarity (bge-m3 via Ollama)
# ============================================================================
EMBEDSIM_MODEL=bge-m3:567m
# Default: fitted on the task's calibration split. Setting it skips the fit.
# EMBEDSIM_TEMPERATURE=0.022

# ============================================================================
# SemIf: Qwen3.5-4B option scoring (MLX); the checkpoint is pinned in SemIf/classifier.py
# ============================================================================
# Default: BF16 (unquantized). 4 or 8 quantizes on load.
# SEMIF_BITS=8

# ============================================================================
# nimble: Bespoke-Nimble-9B decision model (MLX); the release is pinned in nimble/setup.sh and classifier.py
# ============================================================================
# Default: classifiers/nimble/models/<revision>/, the merged checkpoint setup.sh builds.
# NIMBLE_MODEL_PATH=/path/to/merged/Bespoke-Nimble-9B

# ============================================================================
# modernbert_jev: ModernBERT-JEV option scorer (PyTorch); pinned in modernbert_jev/classifier.py
# ============================================================================
# Default: cuda, else mps, else cpu.
# MODERNBERT_JEV_DEVICE=mps
# Default: torch. onnx runs the release's fp32 ONNX graph on CPU (setup.sh then downloads it, ~600 MB).
# MODERNBERT_JEV_BACKEND=onnx

# ============================================================================
# decider: Decider-4B v3 (decider-ai, PyTorch MPS + MLX kernels); pinned in decider/classifier.py
# ============================================================================
# Default: cuda, else mps, else cpu. Leave DECIDER_TEMPERATURE and DECIDER_SCHEMA_CACHE unset: the app runs the
# release's per-type temperatures without the schema cache, and refuses to start if either is set.
# DECIDER_DEVICE=mps

# ============================================================================
# strands_decider: Strands Decider 2B hobson-v19 (strands-decider, MLX); pinned in strands_decider/classifier.py
# ============================================================================
# Not the `decider` app: a different model (Strands Labs, AWS). Default: mlx on Apple silicon, else cuda, else mps,
# else cpu. mps and cpu are the package's PyTorch paths (slower; cpu is the float32 reference of the parity check).
# STRANDS_DECIDER_DEVICE=mlx

# ============================================================================
# d1: LiquidAI/d1-3B native System One choice scoring (PyTorch); pinned in d1/classifier.py
# ============================================================================
# Default: cuda, else mps, else cpu. The model is BF16 on accelerators and float32 on CPU.
# D1_DEVICE=mps

# ============================================================================
# plumb, plumb_shortlist: Plumb-4B (jevk5 prompt, MLX forward pass); pinned in plumb/classifier.py
# ============================================================================
# Default: BF16 (unquantized). 4 or 8 quantizes the body on load.
# PLUMB_BITS=8

# ============================================================================
# winnow, winnow_shortlist: Winnow-12B Q8_0, local llama.cpp server (winnow/server/serve.sh)
# ============================================================================
# Where the client reaches the server; serve.sh listens on its port.
WINNOW_URL=http://127.0.0.1:8091
# Server context in tokens (the profile's default is 65536; 8192 fits every task's longest prompt).
# WINNOW_CONTEXT=8192
# Default: no auth. Only if the server was started with --api-key-file.
# WINNOW_API_KEY=

# ============================================================================
# clm: CLM-v0.1-8B heads on Qwen3-8B (PyTorch); pinned in clm/classifier.py
# ============================================================================
# Default: cuda, else mps, else cpu.
# CLM_DEVICE=mps
# Default: fitted on the task's calibration split. Setting it skips the fit.
# CLM_TEMPERATURE=1.0

# ============================================================================
# llmqwen (and llmqwen_shortlist): the llm/ app, one model (Qwen 3.8 27B q4)
# ============================================================================
# Default: OLLAMA_HOST. The runner checks, measures and unloads these models on this server.
# Results go to llm/results/<model tag>/, so changing a model below never mixes results.
LLM_HOST=http://127.0.0.1:11434
# Context window in tokens (Ollama's num_ctx). More context = more memory on the server.
LLM_NUM_CTX=64000
# The model the runner benchmarks (passed to llm/ as --model).
LLMQWEN_MODEL=qwen3.8:27b-q4_K_M

# llm/ run by hand without --model (python evaluate.py / classifier.py).
LLM_MODEL=qwen3.8:27b-q4_K_M

# ============================================================================
# OpenJev: DiffusionGemma 26B-A4B, local MLX server (OpenJev/server/serve.sh)
# ============================================================================
# Where the client reaches the server; serve.sh listens on OPENJEV_HOST:OPENJEV_PORT.
OPENJEV_URL=http://127.0.0.1:8080
# OPENJEV_HOST=127.0.0.1
# OPENJEV_PORT=8080
OPENJEV_MLX_MODEL=mlx-community/diffusiongemma-26B-A4B-it-4bit
# Default: no auth. When set, serve.sh and the client both use it.
# OPENJEV_API_KEY=

# ============================================================================
# djev: DiffusionGemma 26B-A4B on a remote GPU host (reached through djev/infra/tunnel.sh)
# ============================================================================
DJEV_URL=http://127.0.0.1:8000
# Default: no auth. Must match the key deploy_gpu_host.sh gave the server.
# DJEV_API_KEY=

# ============================================================================
# embedsup_centroid, embedsup_logreg: bge-m3 embeddings + supervised head (Ollama + CPU)
# ============================================================================
EMBEDSUP_MODEL=bge-m3:567m

# ============================================================================
# tfidf_logreg, tfidf_logreg_4k, tfidf_svm, tfidf_svm_raw, tfidf_cnb: no settings here
# ============================================================================
# Hyperparameters are selected per task on the train split (<app>/hyperparameters.json).

# ============================================================================
# scratch_fasttext, scratch_cnn, scratch_bilstm: neural networks trained locally from scratch
# ============================================================================
# Trained on the task's train split on the first run; saved in classifiers/<app>/models/<task>/.
# SCRATCH_FASTTEXT_DEVICE=cpu    # default cpu (measured: one AG News epoch 14 s on CPU, 13 s on MPS)
# SCRATCH_CNN_DEVICE=mps         # default: mps when available, else cpu (one AG News epoch: 20 s MPS, 145 s CPU)
# SCRATCH_BILSTM_DEVICE=cpu      # default cpu (one AG News epoch: 102 s CPU, 109 s MPS)

# ============================================================================
# finetune_modernbert, finetune_deberta: pre-trained encoders fine-tuned locally on the task's train split
# ============================================================================
# The pinned backbone is downloaded by setup.sh into classifiers/<app>/models/base/; fine-tuned models are saved in
# classifiers/<app>/models/<task>/<digest>/ (hundreds of MB each). Training uses bfloat16 autocast on MPS.
# FINETUNE_MODERNBERT_DEVICE=mps   # default: mps when available, else cpu (CPU fine-tuning would take many hours)
# FINETUNE_DEBERTA_DEVICE=mps
